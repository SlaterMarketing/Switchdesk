#!/usr/bin/env node
// A stand-in Go language server for the app's tests: hover answers, and every opened file gets one
// warning saying where the server ran.
'use strict';

let buf = Buffer.alloc(0);
const where = process.env.SSH_CONNECTION ? 'over ssh' : 'here';
const send = (o) => {
  const body = Buffer.from(JSON.stringify({ jsonrpc: '2.0', ...o }));
  process.stdout.write(`Content-Length: ${body.length}\r\n\r\n`);
  process.stdout.write(body);
};
process.stdin.on('data', (chunk) => {
  buf = Buffer.concat([buf, chunk]);
  for (;;) {
    const end = buf.indexOf('\r\n\r\n');
    if (end < 0) return;
    const len = Number((/Content-Length: (\d+)/i.exec(buf.slice(0, end).toString()) || [])[1]);
    if (buf.length < end + 4 + len) return;
    const m = JSON.parse(buf.slice(end + 4, end + 4 + len).toString());
    buf = buf.slice(end + 4 + len);
    if (m.method === 'initialize') send({ id: m.id, result: { capabilities: { hoverProvider: true, textDocumentSync: 1 } } });
    else if (m.method === 'textDocument/didOpen')
      send({ method: 'textDocument/publishDiagnostics', params: { uri: m.params.textDocument.uri, diagnostics: [{ range: { start: { line: 0, character: 0 }, end: { line: 0, character: 4 } }, severity: 2, message: `fake problem ${where}` }] } });
    else if (m.method === 'textDocument/hover') send({ id: m.id, result: { contents: { kind: 'markdown', value: `fake hover ${where}` } } });
    else if (m.method === 'exit') process.exit(0);
    else if (m.id != null) send({ id: m.id, result: null });
  }
});
